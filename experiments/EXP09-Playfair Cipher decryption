#include <stdio.h>
#include <string.h>
#include <ctype.h>
//Playfair Cipher decryption
char matrix[5][5];

// Generate Playfair matrix
void generateMatrix(char key[])
{
    int used[26] = {0};
    int i, j = 0, k = 0;

    used['J' - 'A'] = 1;   // I/J combined

    for(i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[j][k++] = ch;
            used[ch - 'A'] = 1;

            if(k == 5)
            {
                j++;
                k = 0;
            }
        }
    }

    for(i = 0; i < 26; i++)
    {
        if(!used[i])
        {
            matrix[j][k++] = 'A' + i;

            if(k == 5)
            {
                j++;
                k = 0;
            }
        }
    }
}

// Find position of character
void findPosition(char ch, int *row, int *col)
{
    if(ch == 'J')
        ch = 'I';

    int i, j;

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

// Prepare plaintext
void prepareText(char input[], char output[])
{
    int i, j = 0;

    for(i = 0; input[i] != '\0'; i++)
    {
        if(isalpha(input[i]))
        {
            char ch = toupper(input[i]);

            if(ch == 'J')
                ch = 'I';

            output[j++] = ch;
        }
    }

    output[j] = '\0';

    char temp[200];
    int len = strlen(output);
    int k = 0;

    for(i = 0; i < len; i++)
    {
        temp[k++] = output[i];

        if(i + 1 < len && output[i] == output[i + 1])
            temp[k++] = 'X';
    }

    if(k % 2 != 0)
        temp[k++] = 'X';

    temp[k] = '\0';

    strcpy(output, temp);
}

// Encryption
void encrypt(char text[])
{
    int i;

    printf("\nEncrypted Text: ");

    for(i = 0; text[i] != '\0'; i += 2)
    {
        int r1, c1, r2, c2;

        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    printf("\n");
}

// Decryption
void decrypt(char text[])
{
    int i;

    printf("\nDecrypted Text: ");

    for(i = 0; text[i] != '\0'; i += 2)
    {
        int r1, c1, r2, c2;

        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 4) % 5],
                   matrix[r2][(c2 + 4) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 4) % 5][c1],
                   matrix[(r2 + 4) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    printf("\n");
}

int main()
{
    char key[100];
    char text[200];
    int i, j;

    printf("Enter Key: ");
    scanf("%s", key);

    getchar();

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\n1. Encrypt\n2. Decrypt\n");
    printf("Enter Choice: ");

    int choice;
    scanf("%d", &choice);

    getchar();

    printf("Enter Text: ");
    fgets(text, sizeof(text), stdin);

    if(choice == 1)
    {
        prepareText(text, text);
        encrypt(text);
    }
    else if(choice == 2)
    {
        char cipher[200];
        int k = 0;

        for(i = 0; text[i] != '\0'; i++)
        {
            if(isalpha(text[i]))
                cipher[k++] = toupper(text[i]);
        }

        cipher[k] = '\0';

        decrypt(cipher);
    }
    else
    {
        printf("Invalid Choice\n");
    }

    return 0;
}
