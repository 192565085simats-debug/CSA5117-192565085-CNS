#include <stdio.h>
#include <string.h>
#include <ctype.h>
//breaking an affine cipher
int modInverse(int a)
{
    int i;
    for(i = 1; i < 26; i++)
    {
        if((a * i) % 26 == 1)
            return i;
    }
    return -1;
}

int main()
{
    char cipher[100], plain[100];
    int a = 3, b = 15;
    int a_inv = modInverse(a);
    int i;

    printf("Affine Cipher Break\n");
    printf("Key Found: a = %d, b = %d\n\n", a, b);

    printf("Enter Cipher Text (CAPITAL letters): ");
    scanf("%s", cipher);

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha(cipher[i]))
        {
            int c = toupper(cipher[i]) - 'A';
            plain[i] = ((a_inv * ((c - b + 26) % 26)) % 26) + 'A';
        }
        else
        {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';

    printf("\nDecrypted Text : %s\n", plain);

    return 0;
}
